{
  "mde_workflow": 3,
  "title": "Gara: dal bando al riesame e alla decisione",
  "description": "Dal bando trovato al riesame dei requisiti (ISO 9001, 8.2.3) e alla decisione registrata dell'account manager se partecipare.",
  "variables": {
    "codice": "il codice del bando su cui si fa il giro, scelto con «Avvia il giro»",
    "capitolato": "il documento di gara del bando, messo dal gruppo in gare/documenti-di-gara/",
    "ricerca": "la ricerca dell'account manager, con la domanda che lascia a ciascun responsabile"
  },
  "steps": [
    {
      "id": "ricerca",
      "agent": "iso9001-account-manager",
      "skill": "cerca-bandi",
      "title": "Cerca i bandi",
      "trigger": {
        "launch": true
      },
      "start": "manual"
    },
    {
      "id": "tecnica",
      "agent": "iso9001-responsabile-tecnico",
      "skill": "scheda-tecnica",
      "title": "Scheda tecnica",
      "trigger": {
        "reply": "avvia-giro",
        "to": "ricerca"
      },
      "start": "ask-owner",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "criterio": "2 — competenza"
      }
    },
    {
      "id": "contratto",
      "agent": "iso9001-responsabile-legale",
      "skill": "scheda-contrattuale",
      "title": "Scheda contrattuale",
      "trigger": {
        "reply": "avvia-giro",
        "to": "ricerca"
      },
      "start": "ask-owner",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "criterio": "4 — rischio contrattuale"
      }
    },
    {
      "id": "delivery",
      "agent": "iso9001-responsabile-delivery",
      "skill": "scheda-delivery",
      "title": "Scheda di delivery",
      "trigger": {
        "reply": "avvia-giro",
        "to": "ricerca"
      },
      "start": "ask-owner",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "criterio": "3 — tempi di consegna"
      }
    },
    {
      "id": "riesame",
      "agent": "iso9001-account-manager",
      "skill": "riesame-requisiti",
      "title": "Riesame dei requisiti",
      "trigger": {
        "after": [
          "tecnica",
          "contratto",
          "delivery"
        ],
        "wait": "all"
      },
      "start": "auto",
      "inputs": {
        "codice": "{codice}",
        "capitolato": "{capitolato}",
        "ricerca": "{ricerca}",
        "schede": {
          "from": [
            "tecnica.scheda",
            "contratto.scheda",
            "delivery.scheda"
          ]
        }
      }
    },
    {
      "id": "decisione",
      "person": "Account manager",
      "title": "Decidi se partecipare",
      "trigger": {
        "after": [
          "riesame"
        ]
      },
      "task": "Leggi il riesame dei requisiti sul bando {codice} e decidi se l'azienda partecipa. La tua scelta, con chi e quando, resta nel registro dei giri: è la registrazione del riesame (ISO 9001, 8.2.3.2).",
      "inputs": {
        "riesame": {
          "from": "riesame.riesame"
        }
      },
      "outcomes": [
        {
          "id": "partecipa",
          "label": "Partecipiamo"
        },
        {
          "id": "rinuncia",
          "label": "Non partecipiamo"
        }
      ]
    }
  ],
  "loops": [
    {
      "id": "rifacimento",
      "steps": [
        "tecnica",
        "contratto",
        "delivery"
      ],
      "until": "approved",
      "restart": "manual"
    }
  ]
}
